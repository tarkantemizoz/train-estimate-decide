{
  "model": {
    "max_p": 100.0,
    "max_demand": 12.0,
    "max_leadtime": 10,
    "train_stochastic_leadtimes": true,
    "train_cyclic_demand": true,
    "max_num_cycles": 7
  },
  "dcl": {
    "n": 5000000,
    "m": 500,
    "h": 21,
